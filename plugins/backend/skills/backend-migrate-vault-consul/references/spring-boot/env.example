# TEMPLATE env sau migration (.env.example / env.template) — CHỈ thông tin KẾT NỐI Consul/Vault
# + định danh app/profile. KHÔNG đặt config/secret của app ở đây (chúng nằm trong Consul/Vault).
# Sinh từ `.env` MỚI đã rút gọn (không lấy từ .env.bak). File `.env` thật KHÔNG chứa comment.
APP_NAME=my-app
SPRING_PROFILES_ACTIVE=dev

# --- Consul (config thường) ---
CONSUL_HOST=localhost
CONSUL_PORT=8500
CONSUL_TOKEN=
CONSUL_PREFIX=config

# --- Vault (secrets) ---
VAULT_URI=http://localhost:8200
# Auth: TOKEN cho local dev (mặc định file mẫu này); APPROLE cho staging/prod
VAULT_AUTH=TOKEN
VAULT_TOKEN=dev-root-token   # dev: app boot bằng TOKEN; cũng là token admin cho seed-vault.sh
# Staging/prod: đổi VAULT_AUTH=APPROLE, bỏ trống VAULT_TOKEN và set 2 dòng dưới:
VAULT_ROLE_ID=
VAULT_SECRET_ID=
VAULT_APP_ROLE_PATH=gw
VAULT_BACKEND=dls-hcm
VAULT_DEFAULT_CONTEXT=global
